{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jalsa",
  "main": "worker.js",
  "compatibility_date": "2026-11-17",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jalsa-auth",
      "database_id": "f147c99a-9be7-4ce4-88e2-8e465420e3ce"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "jalsa-media"
    }
  ],
  "vars": {
    "MAIL_FROM": "JALSA <Accountservice@jalsa.me>",
    "REPLY_TO": "support@jalsa.me",
    "ADMIN_EMAIL": "1mr.cute3@gmail.com",
    "PADDLE_ENVIRONMENT": "production",
    "PADDLE_CLIENT_TOKEN": "live_612eeafdfbbb9103dd8a9e53730",
    "PADDLE_PRICE_ID": "pri_01m83yfbztdh6nnq7d7hcbmf53"
  },
  "previews": {
    "r2_buckets": [
      {
        "binding": "MEDIA",
        "bucket_name": "jalsa-media"
      }
    ],
    "vars": {
      "MAIL_FROM": "JALSA <Accountservice@jalsa.me>",
      "REPLY_TO": "support@jalsa.me",
      "ADMIN_EMAIL": "1mr.cute3@gmail.com",
      "STRIPE_PRICE_ID": "price_1Uefk5HUmKKASX4ki1gof5gw",
      "PADDLE_ENVIRONMENT": "sandbox",
      "PADDLE_PRICE_ID": "pri_01m83p9227pxdkyw07q63asq0q"
    },
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "jalsa-auth-preview",
        "database_id": "5a867196-333c-416c-94c2-a0833f69728a"
      }
    ],
    "observability": {
      "enabled": true,
      "logs": {
        "enabled": true,
        "invocation_logs": true,
        "persist": true
      }
    }
  }
}
